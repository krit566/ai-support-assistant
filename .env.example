# Copy to .env (never commit .env). Used by docker-compose.yml.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
POSTGRES_PASSWORD=replace-me
# Optional: LLM-written answers (they must cite the passages they were given)
USE_LLM=false
GROQ_API_KEY=
# Optional, for the demo seed script
SEED_PASSWORD=
